# ─────────────────────────────────────────
# Banco de Dados
# ─────────────────────────────────────────
DATABASE_URL="postgresql://appuser:secret@localhost:5432/appdb"

# ─────────────────────────────────────────
# Autenticação
# ─────────────────────────────────────────
JWT_SECRET="super_secret_key_change_me"
ACCESS_TOKEN_EXPIRES="15m"      # opcional: duração do JWT
REFRESH_TOKEN_EXPIRES="30d"
$secret = (Get-Content .env |
           Where-Object { $_ -match '^JWT_SECRET=' } |
           ForEach-Object { $_.Split('=')[1].Trim('"') })

# ─────────────────────────────────────────
# API Externa
# ─────────────────────────────────────────
GOV_API_URL="https://api.gov.br/v1"

# ─────────────────────────────────────────
# Configuração da aplicação
# ─────────────────────────────────────────
NODE_ENV="development"
PORT=3000
BCRYPT_SALT_ROUNDS=10

# ─────────────────────────────────────────
# Cache / Mensageria (caso use)
# ─────────────────────────────────────────
# REDIS_URL="redis://localhost:6379"
# RABBIT_URL="amqp://guest:guest@localhost:5672"
