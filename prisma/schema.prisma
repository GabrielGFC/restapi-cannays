generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  CLINIC
  CLIENT_FUNCIONARIO   // novo perfil
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  role      Role
  createdAt DateTime @default(now())

  access   Access?
  profile  Profile?
}

model Access {
  userId       String  @id   @map("id_user")
  passwordHash String
  token        String  @unique
  refreshToken String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Profile {
  userId        String   @id @map("id_user")

  patientNumber String?  @unique      // se PATIENT
  crm           String?  @unique      // se DOCTOR
  clinicCode    String?  @unique      // se CLINIC
  employeeCode  String?  @unique      // se CLIENT_FUNCIONARIO

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@check(
    "( (patient_number IS NOT NULL)::int +
        (crm            IS NOT NULL)::int +
        (clinic_code    IS NOT NULL)::int +
        (employee_code  IS NOT NULL)::int ) = 1"
  )
}
